<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!--
            screenOrientation="sensorLandscape" : 가로 고정 (좌우 뒤집기는 허용).
              JS 플러그인보다 우선하는 권위 있는 계층이라 앱 시작 순간부터 적용된다.
            configChanges 에 orientation|screenSize 유지 필수:
              없으면 회전 시 Activity 가 재생성되어 WebView 가 날아가고 게임이 재시작된다.
            docs/03-tech/25-capacitor-mobile.md §3.1
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:screenOrientation="sensorLandscape"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          ★★★ **Google Mobile Ads 앱 ID — 없으면 앱이 시작하자마자 죽는다.**

            AdMob SDK 의 `MobileAdsInitProvider` 는 **앱 프로세스가 뜨는 순간**
            이 meta-data 를 읽는다. `ads.json:enabled` 가 false 여서 우리가 SDK 를
            한 번도 부르지 않아도 그렇다 — 코드가 아니라 매니페스트가 트리거이므로
            "광고를 끄면 괜찮다"가 성립하지 않는다. 플러그인을 의존성에 넣는
            순간부터 이 줄이 필요하다.

          ★★ 지금 값은 **구글 공식 테스트 앱 ID** 다. AdMob 계정을 만들고 실제
            앱을 등록하면 `ca-app-pub-<계정>~<앱>` 으로 바꾼다.
            **광고 단위 ID(`.../…`)가 아니라 앱 ID(`...~…`)다** — 구분자가
            슬래시가 아니라 물결(~)이고, 둘을 바꿔 넣으면 초기화가 실패한다.
            광고 단위 ID 는 `src/game/data/ads.json:units` 가 갖는다.

          절차: docs/06-release/56-admob-rewarded-integration.md §1 · §2
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
